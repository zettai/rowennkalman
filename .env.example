# Names only, never values. Local values go in .env.local (gitignored); production values in Netlify.

# Who can sign in (comma-separated email addresses) and the session signing secret (32+ chars).
ROWENNKALMAN_ADMIN_EMAILS=
ROWENNKALMAN_SESSION_SECRET=

# Public address used in sign-in emails. Optional: Netlify's own URL variable is used when unset.
ROWENNKALMAN_SITE_URL=

# Scaleway bucket. All six set = S3 storage; none set = local ./.data (dev only; Netlify's disk is thrown away).
ROWENNKALMAN_S3_ENDPOINT=
ROWENNKALMAN_S3_REGION=
ROWENNKALMAN_S3_BUCKET=
ROWENNKALMAN_S3_ACCESS_KEY=
ROWENNKALMAN_S3_SECRET_KEY=
ROWENNKALMAN_PUBLIC_IMAGE_BASE=

# Local store folder override (tests use it). Optional.
ROWENNKALMAN_DATA_DIR=

# Email (sign-in links and the contact form). Without the key, links and messages are printed
# and sign-in links are written to <data dir>/outbox/login-links.jsonl.
ROWENNKALMAN_RESEND_API_KEY=
ROWENNKALMAN_CONTACT_TO=
ROWENNKALMAN_CONTACT_FROM=
