{
  "name": "rowennkalman",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:a11y": "jest --testPathPattern=a11y",
    "a11y:pages": "bash scripts/a11y-pages.sh",
    "a11y": "npm run a11y:pages",
    "e2e": "playwright test",
    "hash-password": "node scripts/hash-password.mjs",
    "placeholders": "node scripts/make-placeholders.mjs",
    "test:coverage": "jest --coverage --coverageReporters=lcov --coverageReporters=text-summary",
    "sonar": "scripts/sonar.sh",
    "image-sizes": "tsx --env-file=.env.local scripts/image-sizes.mts",
    "upload-failures": "tsx --env-file=.env.local scripts/upload-failures.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@netlify/functions": "^6.0.0",
    "jose": "^5.10.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jest": "^29.7.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jpeg-js": "^0.4.4",
    "pa11y-ci": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
